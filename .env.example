APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:YOUR_APP_KEY_HERE
APP_DEBUG=true
APP_URL=http://localhost:8000

# Trusted Proxies (IPs autorisées à forwarder les requêtes)
# Développement: localhost uniquement
# Production: IPs de vos proxies (Cloudflare, load balancers, etc.)
TRUSTED_PROXIES=127.0.0.1,::1

# API Forex pour les taux de change
FOREX_API_PROVIDER=exchangerate-api
EXCHANGERATE_API_KEY=
FOREX_BASE_CURRENCY=USD
FOREX_CACHE_DURATION=3600

# Google Maps API pour la localisation GPS (désactivée - utilisation de Leaflet/OpenStreetMap)
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_ENABLED=false
GOOGLE_MAPS_DEFAULT_ZOOM=6
GOOGLE_MAPS_DEFAULT_LAT=-4.0383
GOOGLE_MAPS_DEFAULT_LNG=21.7587

# Paiement Mobile Money
ILLICOCASH_ENABLED=true
ILLICOCASH_API_KEY=
ILLICOCASH_API_SECRET=

ORANGE_MONEY_ENABLED=true
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_API_SECRET=

AIRTEL_MONEY_ENABLED=true
AIRTEL_MONEY_API_KEY=
AIRTEL_MONEY_API_SECRET=

MPESA_ENABLED=true
MPESA_API_KEY=your_mpesa_api_key_here
MPESA_API_SECRET=your_mpesa_api_secret_here

AFRICELL_ENABLED=true
AFRICELL_API_KEY=
AFRICELL_API_SECRET=

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_CD

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
 DB_HOST=127.0.0.1
 DB_PORT=3306
 DB_DATABASE=vintapp
 DB_USERNAME=root
 DB_PASSWORD=your_database_password_here

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"


#envoie email apres preinscription
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD="your_gmail_app_password_here"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your_email@gmail.com
MAIL_FROM_NAME=Vintapp

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
DISABLE_GEO_RESTRICTION=false

# key bot
OPENAI_API_KEY=your_openai_api_key_here

VITE_APP_NAME="${APP_NAME}"
