# ===================================
# PawaPay Mobile Money Aggregator
# ===================================

# Active ou désactive l'intégration PawaPay
PAWAPAY_ENABLED=false

# Environment: sandbox (test) or production (live)
# Sandbox dashboard: https://dashboard.sandbox.pawapay.io
# Production dashboard: https://dashboard.pawapay.io
PAWAPAY_ENVIRONMENT=sandbox

# API token généré depuis le dashboard PawaPay
# (différent entre sandbox et production)
PAWAPAY_API_TOKEN=

# URL du callback (webhook) qui recevra les statuts finaux
# Doit être accessible publiquement (HTTPS) et idempotent
#
# Configurez UNE URL par type d'opération dans le dashboard PawaPay :
PAWAPAY_CALLBACK_DEPOSIT=https://vintapp.imasomo.com/api/v1/pawapay/callback/deposit
PAWAPAY_CALLBACK_CHECKOUT=https://vintapp.imasomo.com/api/v1/pawapay/callback/checkout
PAWAPAY_CALLBACK_PAYOUT=https://vintapp.imasomo.com/api/v1/pawapay/callback/payout
PAWAPAY_CALLBACK_REFUND=https://vintapp.imasomo.com/api/v1/pawapay/callback/refund
#
# (Optionnel) URL unique legacy pour les anciens dépôts déjà configurés :
PAWAPAY_CALLBACK_URL=https://vintapp.imasomo.com/payments/pawapay/notify

# Surcharge optionnelle de l'URL de base de l'API
# PAWAPAY_BASE_URL=https://api.sandbox.pawapay.io

# --- Signatures RFC-9421 (optionnel, seconde couche de sécurité) ---
# À activer seulement si "Only accept signed requests" est activé
# sur le dashboard PawaPay
PAWAPAY_SIGN_REQUESTS=false
# ID de la clé tel que renseigné dans le dashboard
PAWAPAY_KEY_ID=
# Chemin vers la clé privée (PEM) utilisée pour signer les requêtes
# PAWAPAY_PRIVATE_KEY_PATH=/chemin/vers/private_key.pem

# --- Signatures RFC-9421 sur les CALLBACKS entrants ---
# À activer seulement si "Only accept signed requests" est activé
# sur le dashboard PawaPay (section callbacks)
PAWAPAY_SIGNED_CALLBACKS=false
