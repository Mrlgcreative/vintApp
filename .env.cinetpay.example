# ===================================
# CinetPay Payment Gateway
# ===================================

# Get your credentials from https://cinetpay.com/
CINETPAY_SITE_ID=124598
CINETPAY_API_KEY=39955468c7a8c0cef1.68322505

# Platform: TEST (sandbox) or PROD (production)
CINETPAY_PLATFORM=TEST

# API Version: V1 or V2 (V2 recommended)
CINETPAY_VERSION=V2

# ===================================
# CinetPay API de Transfert (Payout)
# ===================================

# Activer les décaissements (transferts vers mobile money)
CINETPAY_TRANSFER_ENABLED=false

# Mot de passe API (distinct de l'API key) défini dans le back-office CinetPay :
# https://cinetpay.com/marchand/integration/
# Utilisé par l'API de transfert https://client.cinetpay.com/v1
CINETPAY_API_PASSWORD=
