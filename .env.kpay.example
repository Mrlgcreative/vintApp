# ===================================
# K-PAY Payment Gateway
# ===================================
# K-PAY encaisse en Mobile Money (USSD) ou via page hébergée et reverse
# vers un compte Mobile Money dans 12 pays africains.
# Documentation : https://kpay.site/documentation

# Active ou désactive l'intégration K-PAY
KPAY_ENABLED=false

# Environment: production (kpay_live_*) or sandbox (kpay_test_*)
KPAY_ENVIRONMENT=production

# Clés générées depuis le dashboard K-PAY (écran Applications)
#   X-API-Key    : kpay_test_... ou kpay_live_...
#   X-Secret-Key : 64 caractères hexadécimaux (affichée une seule fois)
KPAY_API_KEY=kpay_live_votre_cle_publique
KPAY_SECRET_KEY=votre_secret_64_hexa

# URL de base de l'API (surcharge optionnelle)
# KPAY_BASE_URL=https://admin.kpay.site

# Secrets pour vérifier les signatures entrantes (différents des clés API) :
# - KPAY_WEBHOOK_SECRET : HMAC des webhooks (header X-KPAY-Signature sur le body brut)
# - KPAY_GATEWAY_SECRET : HMAC du retour de la page hébergée
#   (signature de "status|reference|externalId|ts")
# (si KPAY_GATEWAY_SECRET est vide, KPAY_WEBHOOK_SECRET est utilisé)
KPAY_WEBHOOK_SECRET=
KPAY_GATEWAY_SECRET=

# URLs de redirection après paiement par page hébergée (GATEWAY)
KPAY_RETURN_URL=https://vintapp.imasomo.com/payments/kpay/return
KPAY_CANCEL_URL=https://vintapp.imasomo.com/payments/kpay/return?status=CANCELLED

# Callbacks configurés côté dashboard K-PAY (jusqu'à 4 URLs) :
#  - Spécifiques : 3 URLs dédiées par type de transaction.
#  - Générique : UNE URL qui reçoit TOUS les types (fallback si spécifique absente).
#
# L'URL générique est requise si vous ne configurez pas les 3 URLs spécifiques.
# Préfixe : https://vintapp.imasomo.com/api/v1/kpay/callback
#
# Si vous n'configurez AUCUNE URL, K-PAY n'envoie aucun webhook
# (utilisez le polling GET /payments/:id comme alternative).
KPAY_CALLBACK_URL=https://vintapp.imasomo.com/api/v1/kpay/callback
KPAY_CALLBACK_DEPOSIT=https://vintapp.imasomo.com/api/v1/kpay/callback/deposit
KPAY_CALLBACK_WITHDRAW=https://vintapp.imasomo.com/api/v1/kpay/callback/withdraw
KPAY_CALLBACK_REFUND=https://vintapp.imasomo.com/api/v1/kpay/callback/refund

# Opérateur par défaut pour les retraits en mode USSD si la détection
# automatique (POST /api/v1/payments/predict-provider) échoue.
# RDC : VODACOM_MPESA_COD | AIRTEL_COD | ORANGE_COD
KPAY_DEFAULT_PROVIDER=VODACOM_MPESA_COD

# Timeout HTTP (secondes)
# KPAY_TIMEOUT=30