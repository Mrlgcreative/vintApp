# Configuration Production - Hostinger
# À COPIER dans .env sur le serveur

APP_NAME=VintApp
APP_ENV=production
APP_KEY=base64:VOTRE_APP_KEY_GENEREE_AVEC_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://votre-domaine.com

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=VOTRE_BASE_DE_DONNEES
DB_USERNAME=VOTRE_NOM_UTILISATEUR_DB
DB_PASSWORD=VOTRE_MOT_DE_PASSE_DB

# Cache & Sessions (Redis recommandé pour la performance)
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# Redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=VOTRE_ADRESSE_EMAIL@gmail.com
MAIL_PASSWORD="VOTRE_MOT_DE_PASSE_APPLICATION_GMAIL"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=VOTRE_ADRESSE_EMAIL@gmail.com
MAIL_FROM_NAME=Vintapp

# Firebase
FIREBASE_CREDENTIALS=storage/firebase/serviceAccountKey.json
FIREBASE_PROJECT_ID=VOTRE_PROJET_FIREBASE
FIREBASE_DATABASE_URL=https://VOTRE_PROJET_FIREBASE-default-rtdb.firebaseio.com/
FIREBASE_STORAGE_BUCKET=VOTRE_PROJET_FIREBASE.appspot.com
FIREBASE_API_KEY=VOTRE_FIREBASE_API_KEY
FIREBASE_AUTH_DOMAIN=VOTRE_PROJET_FIREBASE.firebaseapp.com
FIREBASE_MESSAGING_SENDER_ID=VOTRE_SENDER_ID
FIREBASE_APP_ID=VOTRE_FIREBASE_APP_ID
FIREBASE_VAPID_KEY=VOTRE_VAPID_KEY

# Pusher
PUSHER_APP_ID=VOTRE_PUSHER_APP_ID
PUSHER_APP_KEY=VOTRE_PUSHER_APP_KEY
PUSHER_APP_SECRET=VOTRE_PUSHER_APP_SECRET
PUSHER_APP_CLUSTER=VOTRE_PUSHER_CLUSTER

# CinetPay
CINETPAY_SITE_ID=VOTRE_CINETPAY_SITE_ID
CINETPAY_API_KEY=VOTRE_CINETPAY_API_KEY
CINETPAY_PLATFORM=PROD
CINETPAY_VERSION=V2

# Telescope (désactivé en production)
TELESCOPE_ENABLED=true
TELESCOPE_PATH=telescope

# Sécurité
TRUSTED_PROXIES=*
