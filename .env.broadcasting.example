# 🔔 Configuration Broadcasting - À ajouter dans votre .env

# Broadcasting Driver (changer de 'log' à 'pusher')
BROADCAST_CONNECTION=pusher

# Pusher Credentials (à récupérer sur https://dashboard.pusher.com)
PUSHER_APP_ID=your_app_id_here
PUSHER_APP_KEY=your_app_key_here
PUSHER_APP_SECRET=your_app_secret_here
PUSHER_APP_CLUSTER=eu
PUSHER_SCHEME=https
PUSHER_HOST=
PUSHER_PORT=443

# Vite Environment Variables (pour le frontend)
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"

# 📝 Instructions:
# 1. Créez un compte gratuit sur https://dashboard.pusher.com/accounts/sign_up
# 2. Créez une nouvelle app (Name: vintapp-notifications, Cluster: eu ou us2)
# 3. Allez dans "App Keys" et copiez: app_id, key, secret, cluster
# 4. Remplacez les valeurs ci-dessus
# 5. Exécutez: php artisan config:clear && php artisan cache:clear
# 6. Redémarrez votre serveur: php artisan serve
# 7. Testez avec 2 utilisateurs dans 2 onglets différents !
