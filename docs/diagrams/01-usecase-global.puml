@startuml
skinparam linetype ortho
left to right direction

title Diagramme de Cas d'Utilisation - VintApp

actor Utilisateur as U

actor Acheteur as B
actor Vendeur as S
actor Admin as A

rectangle "Systeme VintApp" {
  (S'authentifier) as UC1
  (Consulter\nle catalogue) as UC2
  (Acheter) as UC3
  (Vendre) as UC4
  (Gerer\nson wallet) as UC5
  (Verifier\nl'authenticite) as UC6
  (Administrer) as UC7
}

U --> UC1

B --|> U
S --|> U
A --|> U

B --> UC2
B --> UC3
B --> UC5
B --> UC6

S --> UC2
S --> UC4
S --> UC5
S --> UC6

A --> UC7

UC3 ..> UC5 : <<include>>
UC4 ..> UC5 : <<include>>
UC3 ..> UC2 : <<include>>

note right of U : Acteur generalise\nTous les utilisateurs\ndoivent s'authentifier

@enduml
