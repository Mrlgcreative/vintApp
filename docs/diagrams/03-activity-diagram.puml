@startuml
title Diagramme d'Activite - Processus d'Achat

start

:Consultuer le catalogue;
:Selectionner un article;

if (Ajouter au panier?) then (oui)
  :Ajouter au panier;
else (non)
  stop
endif

:Passer commande;

if (Mode de paiement?) then (Wallet)
  :Debiter le wallet;
else (Carte / Mobile Money)
  :Rediriger vers\nle paiement externe;
  :Attente confirmation\npasserelle;

  if (Paiement accepte?) then (oui)
  else (non)
    :Annuler commande;
    stop
  endif
endif

:Notifier le vendeur;
:Preparer la commande;

if (Livraison locale?) then (oui)
  :Planifier la livraison;
  :Suivre en temps reel (GPS);
else (non)
  :Expedier par transporteur;
endif

:Notifier l'acheteur;

if (Acheteur confirme\nreception?) then (oui)
  :Valider la commande;
  :Crediter le wallet vendeur;
  :Inviter a noter;
else (non)
  :Ouvrir un litige;
  if (Litige resolu?) then (oui)
    :Valider ou\nrembourser;
  else (non)
    :Escalade admin;
  endif
endif

stop

@enduml
