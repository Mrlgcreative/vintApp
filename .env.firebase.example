# ========================================
# FIREBASE CONFIGURATION
# ========================================

# Firebase Web Configuration (Client-side JavaScript)
# Récupérer depuis Firebase Console → Project Settings → General → Your apps → Web app
FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
FIREBASE_AUTH_DOMAIN=votre-projet.firebaseapp.com
FIREBASE_PROJECT_ID=votre-projet
FIREBASE_STORAGE_BUCKET=votre-projet.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Firebase Server-side Configuration (PHP SDK - optionnel pour pré-inscription)
# Télécharger depuis Firebase Console → Project Settings → Service Accounts
FIREBASE_CREDENTIALS="${FIREBASE_CREDENTIALS}"
FIREBASE_DATABASE_URL=https://votre-projet.firebaseio.com

# Firebase Cloud Messaging (optionnel - pour notifications push)
FIREBASE_VAPID_KEY=
FIREBASE_SERVER_KEY=

# ========================================
# INSTRUCTIONS DE CONFIGURATION
# ========================================

# 1. Créer un projet Firebase : https://console.firebase.google.com
# 2. Activer Authentication → Email/Password
# 3. Créer Firestore Database
# 4. Récupérer les clés Web (Firebase Console → Settings)
# 5. Remplacer les valeurs ci-dessus
# 6. Pour le fichier credentials JSON :
#    - Télécharger depuis Service Accounts
#    - Placer dans storage/firebase/
#    - Mettre le chemin : storage/firebase/serviceAccountKey.json
