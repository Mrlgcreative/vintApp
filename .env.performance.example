# ========================================
# OPTIMISATIONS DE PERFORMANCE - VintApp
# ========================================
# Ajoutez ces variables à votre fichier .env
# pour activer toutes les optimisations

# ----------------------------------------
# CACHE CONFIGURATION
# ----------------------------------------
CACHE_STORE=database              # Options: database, redis, memcached
                                   # Recommandé: redis pour production

# Durées de cache (en secondes)
CACHE_ITEMS_LIST=300              # 5 minutes pour liste items
CACHE_ITEM_DETAIL=600             # 10 minutes pour détail item
CACHE_CATEGORIES=3600             # 1 heure pour catégories
CACHE_BRANDS=3600                 # 1 heure pour marques
CACHE_SETTINGS=7200               # 2 heures pour paramètres
CACHE_USER_STATS=300              # 5 minutes pour stats utilisateur
CACHE_POPULAR_ITEMS=900           # 15 minutes pour items populaires

# ----------------------------------------
# PERFORMANCE GÉNÉRALE
# ----------------------------------------
PERFORMANCE_CACHE_ENABLED=true    # Activer le système de cache
HTTP_COMPRESSION_ENABLED=true     # Activer compression GZIP
HTTP_CACHE_ENABLED=true           # Activer cache HTTP
DB_USE_PERFORMANCE_INDEXES=true   # Utiliser les index de performance
DB_EAGER_LOADING=true             # Activer eager loading

# ----------------------------------------
# OPTIMISATION IMAGES
# ----------------------------------------
IMAGES_THUMBNAILS_ENABLED=true    # Générer thumbnails automatiquement
IMAGES_COMPRESSION_QUALITY=80     # Qualité compression (1-100)
IMAGES_LAZY_LOADING=true          # Activer lazy loading

# ----------------------------------------
# HTTP COMPRESSION
# ----------------------------------------
HTTP_COMPRESSION_MIN_SIZE=1024    # Taille minimum pour compression (bytes)

# ----------------------------------------
# RATE LIMITING (requêtes par minute)
# ----------------------------------------
RATE_LIMIT_API_DEFAULT=60         # Limite par défaut
RATE_LIMIT_API_READ=100           # Pour requêtes GET
RATE_LIMIT_API_WRITE=20           # Pour POST/PUT/DELETE
RATE_LIMIT_API_PUBLIC=30          # Pour routes publiques
RATE_LIMIT_WEB_DEFAULT=60         # Pour routes web

# ----------------------------------------
# PAGINATION
# ----------------------------------------
PAGINATION_ITEMS=12               # Items par page
PAGINATION_ORDERS=20              # Commandes par page
PAGINATION_MESSAGES=50            # Messages par page

# ----------------------------------------
# QUEUE OPTIMIZATION
# ----------------------------------------
QUEUE_ENABLED=true                # Activer les queues
QUEUE_IMAGE_OPTIMIZATION=true     # Optimiser images en queue
QUEUE_EMAIL_SENDING=true          # Envoyer emails en queue
QUEUE_NOTIFICATIONS=true          # Notifs en queue

# ----------------------------------------
# MONITORING
# ----------------------------------------
MONITOR_SLOW_QUERIES=true         # Logger requêtes lentes
MONITOR_SLOW_QUERY_THRESHOLD=1000 # Seuil requête lente (ms)
MONITOR_CACHE_ERRORS=true         # Logger erreurs cache

# ----------------------------------------
# REDIS CONFIGURATION (Recommandé)
# ----------------------------------------
# Décommentez pour activer Redis:

# CACHE_STORE=redis
# REDIS_CLIENT=phpredis            # ou predis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379
# REDIS_DB=0                       # Database Redis (0-15)
# REDIS_CACHE_DB=1                 # Database pour cache
# REDIS_PREFIX=vintapp_cache:      # Préfixe des clés

# ----------------------------------------
# OPCACHE (Production seulement)
# ----------------------------------------
# À configurer dans php.ini:
# opcache.enable=1
# opcache.memory_consumption=256
# opcache.interned_strings_buffer=16
# opcache.max_accelerated_files=20000
# opcache.validate_timestamps=0
# opcache.save_comments=1
# opcache.fast_shutdown=1

# ----------------------------------------
# NOTES IMPORTANTES
# ----------------------------------------
# 1. En production, utilisez REDIS pour le cache
# 2. Activez OPcache dans php.ini
# 3. Exécutez: php artisan config:cache
# 4. Exécutez: php artisan route:cache
# 5. Exécutez: composer dump-autoload -o
# 6. Testez avec: php test_performance_optimizations.php
